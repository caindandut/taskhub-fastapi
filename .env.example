# Use an existing MySQL 8 account with permission to create the taskhub database.
# Replace USERNAME and PASSWORD; URL-encode special characters in the password.
# Copy this file to .env. Never commit .env.
APP_NAME=TaskHub API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
DATABASE_URL=mysql+aiomysql://USERNAME:PASSWORD@127.0.0.1:3306/taskhub?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://127.0.0.1:6379/0
TASK_CACHE_TTL_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
