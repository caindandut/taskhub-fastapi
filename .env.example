# Use an existing MySQL 8 account with permission to create the taskhub database.
# Replace USERNAME and PASSWORD; URL-encode special characters in the password.
# Copy this file to .env. Never commit .env.
DATABASE_URL=mysql+aiomysql://USERNAME:PASSWORD@127.0.0.1:3306/taskhub?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
